{
  "name": "imvo-website",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/IMVO-SYSTEMS/imvo-website.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cms:migrate": "sanity exec scripts/migrate-cms-backend.ts --with-user-token",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "build:next": "next build",
    "build:cloudflare": "vite build",
    "deploy:cloudflare": "wrangler deploy --keep-vars"
  },
  "dependencies": {
    "@sanity/orderable-document-list": "^2.0.14",
    "@sanity/vision": "^6.5.0",
    "@vinext/cloudflare": "latest",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "next": "16.1.6",
    "next-sanity": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "sanity": "^6.5.0",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "latest",
    "vite-css-modules": "latest",
    "wrangler": "latest"
  },
  "type": "module"
}
